{
  "name": "next-blog",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "migrate:create": "lontar migrate:create",
    "migrate": "lontar migrate",
    "generate:types": "lontar generate:types",
    "seed": "tsx scripts/seed.ts",
    "fetch:posts": "tsx scripts/fetch-posts.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "lontar migrate && playwright test",
    "test:e2e:postgres": "DATABASE_URL=\"${POSTGRES_URL:-postgres://lontar:lontar@127.0.0.1:5432/lontar}\" lontar migrate && DATABASE_URL=\"${POSTGRES_URL:-postgres://lontar:lontar@127.0.0.1:5432/lontar}\" playwright test"
  },
  "dependencies": {
    "@lontar/admin": "workspace:*",
    "@lontar/core": "workspace:*",
    "@lontar/db-mysql": "workspace:*",
    "@lontar/db-postgres": "workspace:*",
    "@lontar/next": "workspace:*",
    "@lontar/preview": "workspace:*",
    "@lontar/storage-local": "workspace:*"
  },
  "devDependencies": {
    "@lontar/cli": "workspace:*",
    "@playwright/test": "^1.51.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "^15.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "4.23.15",
    "typescript": "~6.0.3"
  }
}
