{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../../",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // vite.config.ts imports the build plugin from src/ by its real path, which
    // Vite's native config loader requires to carry an extension.
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    // `paths` replaces the base config's rather than merging with it, so the
    // one entry this package uses from there is repeated. Mirrored in
    // vite.config.ts; `@/` is what the copied shadcn sources import.
    "paths": {
      "@/*": ["./src/*"],
      "@lontar/core/client": ["../core/src/client/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
