{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../../",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // vite.config.ts imports the build plugin from src/ by its real path, which
    // Vite's native config loader requires to carry an extension.
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
