{
  "name": "@lontar/core",
  "version": "0.2.0",
  "description": "Lontar core: config, fields, validation, hooks, access control, REST API (Hono) and Local API.",
  "keywords": [
    "lontar",
    "cms",
    "headless-cms",
    "typescript",
    "hono",
    "zod",
    "rest-api"
  ],
  "license": "MIT",
  "homepage": "https://github.com/handi7/lontar-cms#readme",
  "bugs": {
    "url": "https://github.com/handi7/lontar-cms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handi7/lontar-cms.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-auth": "^1.7.14",
    "file-type": "^22.3.0",
    "hono": "^4.13.14",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
