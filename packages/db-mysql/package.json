{
  "name": "@lontar/db-mysql",
  "version": "0.4.0",
  "description": "MySQL database adapter for Lontar, built on Drizzle ORM.",
  "keywords": [
    "lontar",
    "cms",
    "headless-cms",
    "typescript",
    "mysql",
    "drizzle",
    "database-adapter"
  ],
  "license": "MIT",
  "homepage": "https://github.com/handi7/lontar-cms#readme",
  "bugs": {
    "url": "https://github.com/handi7/lontar-cms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handi7/lontar-cms.git",
    "directory": "packages/db-mysql"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "mysql2": "^3.24.6"
  },
  "peerDependencies": {
    "@lontar/core": "workspace:^"
  },
  "devDependencies": {
    "@lontar/core": "workspace:*",
    "@lontar/db-test-suite": "workspace:*",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
