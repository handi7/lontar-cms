# Matches the credentials in docker-compose.yml.
# Copy to .env and adjust if you point at your own MySQL.
DATABASE_URL=mysql://lontar:lontar@127.0.0.1:3306/lontar

# Dedicated database for integration tests so running tests doesn't drop dev data.
TEST_DATABASE_URL=mysql://lontar:lontar@127.0.0.1:3306/lontar_test

# Used to sign sessions. Generate a real one for anything but local dev.
LONTAR_SECRET=dev-secret-change-me
