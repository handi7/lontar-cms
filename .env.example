# Matches the credentials in docker-compose.yml.
# Copy to .env and adjust if you point at your own MySQL or PostgreSQL.
DATABASE_URL=mysql://lontar:lontar@127.0.0.1:3306/lontar

# Dedicated database for integration tests so running tests doesn't drop dev data.
TEST_DATABASE_URL=mysql://lontar:lontar@127.0.0.1:3306/lontar_test

# PostgreSQL database URLs (matches docker-compose.yml postgres service).
POSTGRES_URL=postgres://lontar:lontar@127.0.0.1:5432/lontar
TEST_POSTGRES_URL=postgres://lontar:lontar@127.0.0.1:5432/lontar_test

# Used to sign sessions. Generate a real one for anything but local dev.
LONTAR_SECRET=dev-secret-change-me

# Public origin of the app that serves the API. Pass it as `baseURL` to
# createRouteHandlers()/createLontar(); Better Auth uses it for redirects and origin checks.
LONTAR_URL=http://localhost:3000
